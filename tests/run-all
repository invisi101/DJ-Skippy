#!/usr/bin/env bash
# Run every suite and summarise. Exits non-zero if any failed.
#
# Suites that need a sound device, a session D-Bus or a free port are run last,
# so a headless environment still gets through the bulk of them.

cd "$(dirname "$0")/.." || exit 1
PY="./.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"

HEADLESS=(smoke responsiveness_test playback_test transport_test browser_test playlist_test
          optional_musicbrainz_test multidisc_test import_test review_test
          watcher_test locking_test equivalence_test robustness_test)
DEVICES=(lifecycle_test soak_test integration)

# Some suites are not quiet neighbours. Say so before starting rather than
# letting music appear from nowhere while someone is listening.
cat <<'WARNING'
Before this starts:

  * Several suites PLAY AUDIO through your speakers for a few seconds each
    (playback, transport, integration). Volume is set low, but you will
    hear it.
  * lifecycle_test starts and kills its own DJ-Skippy instances. It refuses
    to run at all if you already have one open, so yours is safe — but it
    will claim the MPRIS name and port 8080 while it runs.
  * The whole run takes several minutes.

WARNING

if [ -t 0 ]; then
    printf 'Press enter to continue, or ctrl-c to stop. '
    read -r _
fi

failed=0
run() {
    printf '%-28s ' "$1"
    out=$(timeout "${2:-300}" "$PY" "tests/$1.py" 2>&1)
    result=$(printf '%s\n' "$out" | grep -E '^(all checks passed|[0-9]+ FAILED)' | tail -1)
    if [ -z "$result" ]; then
        result="NO RESULT"
    fi
    echo "$result"
    case "$result" in
        "all checks passed") ;;
        *) failed=$((failed + 1)) ;;
    esac
}

echo "── headless ──"
for suite in "${HEADLESS[@]}"; do run "$suite"; done
echo
echo "── needs a sound device / D-Bus / a free port ──"
for suite in "${DEVICES[@]}"; do run "$suite" 400; done

echo
if [ "$failed" -eq 0 ]; then
    echo "all suites passed"
else
    echo "$failed suite(s) failed"
fi
exit "$failed"
